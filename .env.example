# Copy this file to .env.local and fill in the values for LOCAL development.
# .env.local is git-ignored. Never commit real credentials.
#
# Staging and production do NOT use this file — their variables are set in the
# Vercel dashboard, scoped per environment. See docs/environments.md.
#
# RULE: local and staging point at the STAGING Supabase project.
#       Only the production deployment points at the PRODUCTION Supabase project.

# --- Which environment is this? ------------------------------------------
# One of: development | staging | production
# Local: "development". Vercel Preview (staging branch): "staging". Vercel Production: "production".
NEXT_PUBLIC_APP_ENV="development"

# --- Supabase (use the STAGING project's values locally) -----------------
# Settings -> API Keys in the Supabase dashboard.
# Publishable key (sb_publishable_...) — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-staging-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret key (sb_secret_...) — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Runtime AI --------------------------------------------------------
# Anthropic API key — used server-side for legal-description extraction and
# (later) natural-language override interpretation. SERVER ONLY.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Auth -------------------------------------------------------------
# Comma-separated list of email addresses allowed to sign in. Backstop for
# the Supabase dashboard's "restrict sign-ups" setting.
AUTH_ALLOWED_EMAILS="owner@example.com,tester@example.com"

# --- App ----------------------------------------------------------------
# Canonical base URL of this deployment (auth redirects, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
