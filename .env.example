# Copy this file to .env.local and fill in the values for LOCAL development.
# .env.local is git-ignored. Never commit real credentials.
#
# Staging and production do NOT use this file — their variables are set in the
# Vercel dashboard, scoped per environment. See docs/environments.md.
#
# RULE: local and staging point at the STAGING Supabase project.
#       Only the production deployment points at the PRODUCTION Supabase project.

# --- Which environment is this? ------------------------------------------
# One of: development | staging | production
# Local: "development". Vercel staging env: "staging". Vercel prod env: "production".
NEXT_PUBLIC_APP_ENV="development"

# --- Supabase (use the STAGING project's values locally) -----------------
# Project URL and anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-staging-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-staging-anon-key"

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-staging-service-role-key"

# --- App ----------------------------------------------------------------
# Canonical base URL of this deployment (auth redirects, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
